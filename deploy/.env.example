# OCI VM 배포용 설정. deploy/.env 로 복사해 값을 바꾼다(deploy/.env 는 커밋하지 않는다).

# 구매한 도메인. DNS A 레코드가 VM 공인 IP 를 가리켜야 Caddy 가 인증서를 받는다.
DOMAIN=chzzk.example.com
# 다운로드 페이지와 클라이언트 안내에 표시할 공개 주소
PUBLIC_URL=https://chzzk.example.com

# 데스크톱 클라이언트 출처(공개 조회 API·시청자 WebSocket 만 허용)
ALLOWED_ORIGINS=app://chzzk
# 클라이언트 설치 파일 위치(GitHub Releases 최신 릴리스)
DOWNLOAD_BASE_URL=https://github.com/qswd0821/chzzk/releases/latest/download

# 후원 결제: 토스 테스트 키가 없으면 내장 모의 결제(실제 결제 아님). 실제 키 값은 이 파일에만 넣고 커밋하지 않는다.
PAYMENT_PROVIDER=auto
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 단일 서버라 Redis 없이 메모리 버스로 동작한다(7단계 K3s 에서 Redis 사용).
REDIS_URL=
LIVE_RECONNECT_GRACE_SECONDS=20
