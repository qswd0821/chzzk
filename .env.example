# 서버 포트
PORT=3000

# SQLite DB 파일, 업로드 영상, 자체 서명 인증서가 저장될 디렉터리 (상대 경로는 프로젝트 루트 기준)
DATA_DIR=./data

# 업로드 허용 최대 용량 (MB)
MAX_UPLOAD_MB=500

# 휴대폰에서 라이브 송출하려면 true. 카메라·마이크는 HTTPS에서만 허용된다.
# HTTPS_KEY/HTTPS_CERT 를 비워 두면 자체 서명 인증서를 자동 생성해 DATA_DIR/tls 에 보관한다.
HTTPS=true
HTTPS_KEY=
HTTPS_CERT=

# WebRTC ICE 서버. STUN 은 쉼표로 여러 개 지정 가능 (기본: Google 공개 STUN)
STUN_URLS=stun:stun.l.google.com:19302
# 휴대폰 LTE ↔ PC Wi-Fi 처럼 서로 다른 네트워크에서 연결이 안 되면 TURN 서버를 지정한다 (예시 값, 실제 비밀 값은 커밋하지 말 것)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
