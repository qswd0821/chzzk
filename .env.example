# 서버 포트
PORT=3000

# SQLite DB 파일, 업로드 영상, 자체 서명 인증서가 저장될 디렉터리 (상대 경로는 프로젝트 루트 기준)
DATA_DIR=./data

# 업로드 허용 최대 용량 (MB)
MAX_UPLOAD_MB=500

# 휴대폰에서 라이브 송출하려면 true. 카메라·마이크는 HTTPS에서만 허용된다.
# HTTPS_KEY/HTTPS_CERT 를 비워 두면 자체 서명 인증서를 자동 생성해 DATA_DIR/tls 에 보관한다.
HTTPS=true
HTTPS_KEY=
HTTPS_CERT=

# WebRTC ICE 서버. STUN 은 쉼표로 여러 개 지정 가능 (기본: Google 공개 STUN)
STUN_URLS=stun:stun.l.google.com:19302
# 휴대폰 LTE ↔ PC Wi-Fi 처럼 서로 다른 네트워크에서 연결이 안 되면 TURN 서버를 지정한다 (예시 값, 실제 비밀 값은 커밋하지 말 것)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# 후원 결제 서비스: auto(기본) | toss | mock
#   auto: 아래 토스 테스트 키가 둘 다 있으면 토스페이먼츠 테스트 모드, 없으면 내장 모의 결제 서비스
PAYMENT_PROVIDER=auto
# 토스페이먼츠 개발자센터(https://developers.tosspayments.com/my/api-keys)의 "API 개별 연동 키" 테스트 키.
# 반드시 test_ 로 시작하는 테스트 키만 쓴다(live_ 키는 서버가 거부한다). 실제 키 값은 커밋하지 말 것.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 여러 인스턴스로 띄울 때(5단계, k8s/app.yaml 에서 설정). 비우면 단일 인스턴스용 메모리 버스를 쓴다.
#   예: REDIS_URL=redis://redis:6379
REDIS_URL=
# 응답 헤더 X-Instance 와 /healthz 에 표시할 인스턴스 이름(비우면 호스트 이름 = k8s 파드 이름)
INSTANCE_ID=
# 송출자 연결이 끊긴 뒤 라이브를 종료하기까지 기다리는 시간(초)
LIVE_RECONNECT_GRACE_SECONDS=20
